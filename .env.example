# T-Bank Invest API — https://www.tbank.ru/invest/open-api/
TBANK_TOKEN=
TBANK_ACCOUNT_ID=
TBANK_SANDBOX=true
TBANK_APP_NAME=tbank-futures-bot

# Фьючерсы (тикеры MOEX через запятую). Пусто = авто Si + RTS ближайшие
TBANK_FUTURES_TICKERS=

# Режим: paper = только сигналы без ордеров, live = реальные заявки (sandbox или prod)
TRADING_MODE=paper

# Risk
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_POSITIONS=2
MIN_SIGNAL_CONFIDENCE=70
DEFAULT_STOP_ATR_MULT=1.4
DEFAULT_TP_ATR_MULT=2.5
STRATEGY_PROFILE=moex_optimal
MOEX_MAIN_SESSION_ONLY=false

# Telegram dashboard
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=
TELEGRAM_ALLOWED_USERNAMES=MaxWell_xR

# Интервал цикла (секунды)
LOOP_INTERVAL_SEC=300
